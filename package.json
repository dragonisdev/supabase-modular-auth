{
  "name": "supabase-modular-auth",
  "version": "1.0.0",
  "private": true,
  "license": "ISC",
  "type": "module",
  "scripts": {
    "api:check": "node scripts/check-openapi.mjs",
    "api:generate": "openapi-typescript openapi/openapi.yaml -o types/src/generated/openapi.ts",
    "build": "pnpm --filter types build && pnpm --filter backend build && pnpm --filter frontend build",
    "dev": "pnpm --filter @supabase-modular-auth/types build && pnpm -r --parallel dev",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "start": "pnpm -r --parallel start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:database": "vitest run test/database",
    "test:live": "vitest run test/live",
    "test:type-check": "tsc --noEmit -p test/tsconfig.json",
    "test:watch": "vitest",
    "type-check": "pnpm --filter types build && pnpm -r --parallel type-check"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "@supabase/supabase-js": "2.112.3",
    "@types/node": "25.4.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "4.1.11",
    "openapi-typescript": "7.13.0",
    "oxfmt": "^0.38.0",
    "oxlint": "^1.53.0",
    "oxlint-tsgolint": "^0.16.0",
    "pg": "8.23.0",
    "supertest": "7.2.2",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0"
  },
  "packageManager": "pnpm@10.32.1"
}
